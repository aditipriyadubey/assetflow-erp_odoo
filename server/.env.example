# server/.env.example
# Copy this file to server/.env and fill in real values.
# server/.env must stay gitignored — never commit real secrets (SDD §31).

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=assetflow_user
DB_PASSWORD=change_me
DB_NAME=assetflow_db

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=10

# CORS — must match the Vite dev server origin exactly
CLIENT_ORIGIN=http://localhost:5173
